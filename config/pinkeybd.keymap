#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#define BASE   0
#define RAISE  1
#define LOWER  2
#define ADJUST 3
#define SCROLL 4
#define MOUSE  5

&lt { tapping-term-ms = <140>; };

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <SCROLL>;
};

/ {
    behaviors {
        // ロータリーエンコーダー（DYA Studioから変更可。以下は初期値）
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <0 1>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <RAISE LOWER>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W      &kp E     &kp R      &kp T  &kp TAB           &kp Y          &kp U     &kp I    &kp O           &kp P
&kp A      &kp S      &kp D     &kp F      &kp G  &lt RAISE SPACE   &kp H          &kp J     &kp K    &kp L           &kp MINUS
&kp Z      &kp X      &kp C     &kp V      &kp B  &mkp RCLK         &kp N          &kp M     &kp COMMA &kp DOT        &kp RS(FSLH)
&kp LSHFT  &kp LCTRL  &kp LGUI  &mkp LCLK                           &lt LOWER RET  &kp BSPC  &kp DEL  &lt MOUSE EQUAL &lt SCROLL RBKT
            >;
            sensor-bindings = <&rsr_vol>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp N1    &kp N2    &kp N3     &kp N4  &kp N5     &trans   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp LEFT  &kp UP    &kp RIGHT  &trans  &kp LANG1  &trans   &trans  &trans  &trans  &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans  &kp LANG2  &trans   &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans     &trans                      &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_trans>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp LS(N1)    &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &kp LS(N5)  &trans   &kp RS(N6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)
&kp LS(LEFT)  &kp LS(UP)  &kp LS(RIGHT)  &trans      &kp LANG1   &trans   &trans      &trans      &trans      &trans      &trans
&kp LEFT      &kp DOWN    &kp RIGHT      &trans      &kp LANG2   &trans   &trans      &trans      &trans      &trans      &trans
&trans        &trans      &trans         &trans                           &trans      &trans      &trans      &trans      &studio_unlock
            >;
            sensor-bindings = <&rsr_trans>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL   &none           &none  &none  &none  &bootloader
&bt BT_CLR    &none         &none         &none         &none         &none            &out OUT_TOG    &none  &none  &none  &none
&none         &none         &none         &none         &none         &none            &studio_unlock  &none  &none  &none  &none
&trans        &trans        &trans        &trans                                       &trans          &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_trans>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_scrl>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans   &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans    &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans    &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans  &trans  &trans                   &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&rsr_scrl>;
        };
    };
};
